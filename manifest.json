{
  "manifest_version": 3,
  "name": "RobuxToGBP",
  "version": "1.0.0",
  "description": "Shows your Robux balance converted to GBP at Roblox's DevEx rate, right next to the balance in the navbar.",
  "permissions": [],
  "host_permissions": [
    "https://www.roblox.com/*",
    "https://users.roblox.com/*",
    "https://economy.roblox.com/*",
    "https://api.frankfurter.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.roblox.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
